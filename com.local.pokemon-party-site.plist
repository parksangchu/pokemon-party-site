<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.pokemon-party-site</string>

  <!-- 설치: ln -sf ~/pokemon-party-site/com.local.pokemon-party-site.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.local.pokemon-party-site.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH" ./run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/socraai/pokemon-party-site</string>

  <!-- 1시간마다. 이전 실행이 끝나지 않았으면 run.sh가 건너뛴다 -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/socraai/pokemon-party-site/logs/run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/socraai/pokemon-party-site/logs/run.log</string>
</dict>
</plist>
